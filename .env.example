# Copy to .env for local development. Never commit real values.
# The server (Netlify Functions)
SAYGDAY_SUPABASE_URL=https://plcowhnsmrgenzsohbrl.supabase.co
SAYGDAY_SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
SAYGDAY_EMAIL_FROM=SayGday <hello@saygday.ai>
SAYGDAY_PUBLIC_URL=https://saygday.ai
# The admin page (/admin): a long passphrase, at least 12 characters
SAYGDAY_ADMIN_PASSWORD=
# Optional
SAYGDAY_SCAN_MODEL=claude-opus-5-5
SAYGDAY_SCAN_SECRET=
# Billing: server / Netlify Functions scope only; never prefix with VITE_.
# Leave blank until Stripe resources are configured. Billing also stays
# disabled in the database until Stripe configuration and rollout tests pass.
# New trials start after verified ownership and card confirmation (8 Oct 2026).
# Use test resources on a separate test site AND database; see docs/billing.md.
SAYGDAY_STRIPE_MODE=test
SAYGDAY_STRIPE_SECRET_KEY=
# Public by design; returned to the authenticated checkout page. Optional for
# the configured saygday.ai live price; required for other accounts/environments.
SAYGDAY_STRIPE_PUBLISHABLE_KEY=
# Active monthly AUD 4000-cent price for the SayGday assistant.
SAYGDAY_STRIPE_PRICE_ID=
SAYGDAY_STRIPE_WEBHOOK_SECRET=
SAYGDAY_STRIPE_PORTAL_CONFIGURATION_ID=
# The browser (public by design)
VITE_SAYGDAY_SUPABASE_URL=https://plcowhnsmrgenzsohbrl.supabase.co
VITE_SAYGDAY_SUPABASE_PUBLISHABLE_KEY=

